# Konfigurasi AI lokal Catatan
#
# AI bersifat opsional. Tanpa CATATAN_AI_URL, Catatan tetap berjalan tanpa AI.

# Ollama
CATATAN_AI_URL=http://127.0.0.1:11434/v1
CATATAN_AI_MODEL=llama3.2

# llama-server
# CATATAN_AI_URL=http://127.0.0.1:8080/v1
# CATATAN_AI_MODEL=local-model

# Kunci API hanya diperlukan jika provider membutuhkannya.
# Jangan masukkan kunci sungguhan ke berkas yang akan di-commit.
# CATATAN_AI_API_KEY=
