# Konfigurasi AI lokal Catatan
#
# AI bersifat opsional. Tanpa CATATAN_AI_URL, Catatan tetap berjalan tanpa AI.

# llama-server
CATATAN_AI_URL=http://127.0.0.1:8080
# CATATAN_AI_MODEL=local-model

# Ollama menggunakan alamat dasar tanpa /v1.
# CATATAN_AI_URL=http://127.0.0.1:11434
# CATATAN_AI_MODEL=llama3.2

# Google Gemini OpenAI-compatible
# CATATAN_AI_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# CATATAN_AI_MODEL=gemini-2.5-flash
# CATATAN_AI_API_KEY=...

# Kunci API hanya diperlukan jika provider membutuhkannya.
# Jangan masukkan kunci sungguhan ke berkas yang akan di-commit.
# CATATAN_AI_API_KEY=

# Temporary test mode: return the model answer even when citation checks fail.
# Keep unset for normal strict citation rejection.
# CATATAN_AI_CITATION_DIAGNOSTIC=true
